tmp/*
!tmp/.gitkeep
!tmp/.gitignore
data/raw/*
data/interim/*
data/features/*
data/datasets/*
!data/*/.gitkeep
__pycache__/
.venv/
*.parquet
data/reference/*
!data/reference/.gitkeep
# Tablas manuales: CSV versionados con fuente por fila (ADR 0027, P1/P2)
!data/reference/README.md
!data/reference/*.csv
!data/reference/index_membership/
!data/reference/index_membership/*.csv
# Registro de modelos: metadata en git, binarios fuera (decision: ver models/README.md)
models/**/model.*

# Entorno y secretos
.env
.env.*
!.env.example
# Herramientas y artefactos
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store
*.duckdb
*.duckdb.wal

# Resumenes de ejecucion de etapas (purgables) y datos derivados
runs/*
!runs/.gitkeep
data/predictions/
data/snapshots/
data/archive/
data/user/
